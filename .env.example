# Copiá este archivo como .env.local y completá los valores desde Supabase.
# Requeridos para la autenticación de la Fase 2.
NEXT_PUBLIC_SUPABASE_URL=
# URL base del proyecto: sin /rest/v1 ni /auth/v1.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origen de esta instalación para enlaces de email y OAuth (sin ruta final).
# En producción: el dominio HTTPS de Tuki. Si cambiás el puerto local, ajustalo.
TUKI_SITE_URL=http://localhost:3000

# Nunca agregues service_role, secret keys ni contraseñas a NEXT_PUBLIC_.

# Opcional: escaneo de tickets. Solo servidor; no hace falta para carga manual.
# Gemini 2.5 Flash-Lite fijo, sin fallback. Usar un proyecto del nivel gratuito.
GEMINI_API_KEY=

# Recordatorios programados opcionales. Desactivados hasta autorización/configuración.
TUKI_AUTOMATIC_REMINDERS_ENABLED=false
TUKI_CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Solo despliegues Vercel Preview/Production: allowlist revisada por el propietario.
# No son secretos; nunca apuntar Preview a un proyecto con datos reales.
# En Preview se exigen ambos orígenes distintos y la URL pública debe ser staging.
# En Production se exige el origen de producción y la URL pública debe coincidir.
# Usar orígenes HTTPS, sin rutas, query ni credenciales. No derivarlos de Host.
TUKI_STAGING_SUPABASE_ORIGIN=
TUKI_PRODUCTION_SUPABASE_ORIGIN=
# VERCEL_ENV lo provee Vercel: no inventarlo para saltar la validación.
